PORT=8080
# Interface to listen on (empty = all). The panel speaks plain HTTP: put a reverse
# proxy with TLS in front of it and set BIND_ADDR=127.0.0.1 (see ROADMAP phase 8).
# BIND_ADDR=127.0.0.1
DB_PATH=./data/squidadmin.db

# Browser origin(s) allowed to call the API (CORS, CSRF and WebSocket checks).
# Comma-separated. Must match what the browser shows in the address bar.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true when the panel is served over HTTPS (Secure flag on the session cookie).
COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For header is believed (IPs/CIDRs, comma-separated).
# Anything else can't spoof the client IP that the audit log and rate limits see.
TRUSTED_PROXIES=127.0.0.1,::1

SQUID_CONF_PATH=/etc/squid/squid.conf
SQUID_ACCESS_LOG=/var/log/squid/access.log
SQUID_BIN=squid

SQUID_BLACKLIST_PATH=/etc/squid/blocked_sites.txt
SQUID_BLACKLIST_ACL=blocked_sites

SQUID_PASSWD_PATH=/etc/squid/passwd
SQUID_AUTH_ACL=authenticated_users
HTPASSWD_BIN=htpasswd
SQUID_BASIC_AUTH_HELPER=/usr/lib/squid/basic_ncsa_auth

# How the panel controls squid: "auto" (systemd if available), "systemd" or "direct".
SQUID_MANAGER=auto
SQUID_SERVICE=squid
SYSTEMCTL_BIN=systemctl
# Run the privileged squid/systemctl commands through `sudo -n`, so the panel can
# run as an unprivileged user. deploy/install.sh sets this up for you.
SQUID_USE_SUDO=false

# First panel account, created only when the panel has no users yet.
# Leave ADMIN_PASSWORD unset: a random one-time password is generated and printed
# once in the log, and must be changed at first login. A weak value (admin123,
# too short, ...) is ignored the same way.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# How often account expiry and daily quotas are re-checked (seconds). A quota is
# enforced at most this long (plus the ~5 s log reader delay) after it is reached.
# POLICY_CHECK_SECONDS=30
