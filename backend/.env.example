PORT=8080
JWT_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/squidadmin.db

SQUID_CONF_PATH=/etc/squid/squid.conf
SQUID_ACCESS_LOG=/var/log/squid/access.log
SQUID_BIN=squid

SQUID_BLACKLIST_PATH=/etc/squid/blocked_sites.txt
SQUID_BLACKLIST_ACL=blocked_sites

SQUID_PASSWD_PATH=/etc/squid/passwd
SQUID_AUTH_ACL=authenticated_users
HTPASSWD_BIN=htpasswd
SQUID_BASIC_AUTH_HELPER=/usr/lib/squid/basic_ncsa_auth

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
